# 1. Use an official, lightweight pre-compiled Python binary base image
FROM python:3.11-slim

# 2. Set structural workspace system directories
WORKDIR /app

# 3. Install foundational system dependencies efficiently
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# 4. Copy and execute optimized requirements caching layers
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# 5. Copy the rest of your application files
COPY . .

# 6. Expose the deployment communication port
EXPOSE 10000

# 7. Execute production server command runtime arguments
CMD ["uvicorn", "app.py:app", "--host", "0.0.0.0", "--port", "10000"]